Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Lidar (red = front)
      Enabled: true
      Length: 0.3
      Radius: 0.02
      Reference Frame: laser
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: Intensity
      Use rainbow: true
      Autocompute Intensity Bounds: true
      Decay Time: 0
      Alpha: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: laser
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Height: 800
  Width: 1100
