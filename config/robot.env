# RECONSTRUCTED from RECOVERY.md/CLAUDE.md (2026-09-30) — not yet run on the robot.
# Robot settings shared by every run/*.sh script. Plain bash: KEY=value, no spaces around '='.
# Anything marked VERIFY is a guess that the first bring-up on the real robot must confirm.

# --- Lidar: Slamtec RPLIDAR C1 via CP2102 USB-TTL stick ---
LIDAR_PORT=auto            # auto = /dev/lidar (udev symlink) if present, else /dev/ttyUSB0
LIDAR_BAUD=460800          # C1 is 460800, NOT 115200
LIDAR_SCAN_MODE=Standard

# --- ESP32-S3 (micro-ROS over serial) ---
ESP32_PORT=auto            # auto = /dev/esp32 (udev symlink), else the first ttyACM*/ttyUSB* that isn't the lidar
AGENT_BAUD=115200          # VERIFY against the firmware (Serial.begin / set_microros_serial_transports)

# --- Topics. The IMU and odom topics are auto-discovered by type if these names aren't found. ---
CMD_VEL_TOPIC=/cmd_vel     # geometry_msgs/Twist consumed by the ESP32 (VERIFY: Twist, not TwistStamped)
ODOM_TOPIC=/odom
IMU_TOPIC=/imu/data_raw    # VERIFY: whatever the firmware publishes
SCAN_TOPIC=/scan           # raw, from sllidar_ros2
SCAN_FILTERED_TOPIC=/scan_filtered   # columns masked: what SLAM, AMCL and Nav2 use

# --- Frames / static transforms (metres, radians) ---
# base_link = centre of the drive axle (plate centre, X=200 mm), on the floor plane.
LASER_X=0.0
LASER_Y=0.0
LASER_Z=0.215              # scan plane height (proven in the last session)
LASER_YAW=-1.5708          # measured -92° ±2° by tools/check_motion.py (2026-10-01): the lidar faces the robot's right
IMU_X=0.0
IMU_Y=0.0
IMU_Z=0.06                 # VERIFY: MPU6050 on deck 1
# Camera mounting. 2026-10-09: lens height by tape (36 cm), pitch from tag 0's position in the image with
# both heights taped (lens 36 / tag centre 40 cm, lidar range 1.62 m): 4.78° down, ±0.5°. Uses no tag
# orientation, which was ambiguous face-on (75/84 sightings) and misled the 2026-10-08 estimates.
# X: 5.5 cm behind the lidar by eye. Y, YAW: tools/camera_pose.py on a monitor (2026-10-08).
# Roll: monitor -0.5°, tag edges +0.25° -> 0. Re-measure if the camera mount is touched.
CAMERA_X=-0.055
CAMERA_Y=-0.0223
CAMERA_Z=0.36
CAMERA_ROLL=0.0
CAMERA_PITCH=0.0834
CAMERA_YAW=0.0368

# --- Camera (nodes/camera_node.py) + AprilTag localization (nodes/tag_map.py) ---
CAMERA_DEV=/dev/video0
CAMERA_WIDTH=1280          # MJPG; the intrinsics in config/camera_intrinsics.yaml are for this size
CAMERA_HEIGHT=720
TAG_SIZE=0.16              # m, the MEASURED black square of the printed tags (tools/make_tags.py)

# --- Odometry calibration (tools/calibrate_odom.py, measured 2026-10-01 on the office carpet) ---
# The firmware over-reports: 3.02 m odometry = 2.72 m tape; 10.90 turns odometry = 10.00 turns gyro
# (the lidar cross-check agreed, 0.93; the hand count of 9.3 was the outlier). Cause consistent with
# an effective wheel diameter of ~90 mm (carpet squish), wheel separation right at 0.350.
# odom_to_tf.py applies these to the TF. SET BOTH TO 1.0 if the firmware is reflashed with the
# corrected WHEEL_DIA (see firmware/campus_bot_base/include/config.h).
ODOM_LIN_SCALE=0.8994
ODOM_ANG_SCALE=0.9171

# --- Driving while mapping (tools/teleop_keys.py). Hard limits: accel ≤ 0.5 m/s², top ≈ 0.8 m/s ---
MAP_LIN_SPEED=0.25         # m/s starting speed while mapping (go slow near the glass room)
MAP_ANG_SPEED=0.5          # rad/s starting turn speed ("turn slowly and gently")
MAX_LIN_SPEED=0.8
MAX_ANG_SPEED=1.2
MAX_LIN_ACCEL=0.5          # m/s² — tower stability, never raise
MAX_ANG_ACCEL=1.0          # rad/s²

# --- Idle behaviour (nodes/auto_clear.py, started with navigation) ---
AUTO_CLEAR=1               # 1: when idle AND boxed in for ~1 min, relocate ≤ 4 m to open floor. 0: off.

# --- Self-mask (scan_filter.py). Returns closer than this are the robot itself (columns). ---
SELF_RADIUS=0.40           # m; the 2020 columns sit ~0.2–0.3 m from the lidar
SCAN_MIN_RANGE=0.25        # m; scan_filter drops ALL closer returns (own columns/cable, vibration-proof)

# --- Buzzers (nodes/buzzer.py; setup/08_buzzer.sh): front GPIO12 = pin 32, rear GPIO13 = pin 33 ---
BUZZER_TYPE=active         # active = they beep by themselves (rhythms); passive = notes via PWM
BUZZER=1                   # 0 = silent robot
BUZZER_LINES=front         # buzzers wired: front (pin 32) and/or rear (pin 33), e.g. front,rear
BUZZER_MOVING=1            # tiny tick every 5 s while driving to a goal (0 = only events)
