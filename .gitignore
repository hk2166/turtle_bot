# colcon / python
build/
install/
log/
__pycache__/
*.pyc
.venv/
# never commit: face data, keys, tokens, flash dumps (may contain WiFi credentials), recovery dumps
*.enc
*.key
.env
faces/
recovered/
*.bin

# PlatformIO build output
.pio/

# maps: commit the .yaml/.pgm/report (small); the slam_toolbox pose graph (~10 MB per map) and the
# automatic backups of replaced maps stay local
maps/*.posegraph
maps/*.data
maps/.prev/
